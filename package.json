{
  "name": "bitemap",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "audit:phase12": "node scripts/phase12-text-audit.mjs",
    "android": "pnpm --filter mobile exec expo run:android",
    "ios": "pnpm --filter mobile exec expo run:ios"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.0",
    "expo-module-scripts": "^55.0.2",
    "eslint": "^10.2.1",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "turbo": "^2.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.58.2"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.1.17",
      "expo-router": "6.0.23",
      "@expo/metro-runtime": "6.1.2"
    }
  }
}
