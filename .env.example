# BiteMap — required environment variables
#
# Copy to .env.local (web) and .env (mobile) and fill in the values from your
# Supabase + Mapbox dashboards.
#
# Missing vars will fail CI via the phase-12 startup sanity check.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Mapbox (client-rendered map tiles) ---
# Browse to https://account.mapbox.com/access-tokens/ and create a public token.
NEXT_PUBLIC_MAPBOX_TOKEN=
EXPO_PUBLIC_MAPBOX_TOKEN=

# --- Open-Meteo ---
# No key required. Tide, weather, swell, pressure — all free, CORS-enabled.

# --- Sentry (error monitoring; free tier ~5k events/mo) ---
# Create a React + Next.js + React Native project at https://sentry.io — use the client DSN.
NEXT_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_DSN=
# Optional: upload source maps from CI / EAS (never commit the token)
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# --- Deferred ---
# Phase 11 also adds:
#   POSTHOG_API_KEY
# Phase 10 Claude Vision:
#   ANTHROPIC_API_KEY (server-side only, used from an Edge Function)
# Phase 8 CSV export email:
#   RESEND_API_KEY (server-side only)
